# Copy to /opt/qbiq/.env.prod on the VM (deploy workflow generates this)
REGISTRY=us-central1-docker.pkg.dev/your-gcp-project/qbiq
IMAGE_TAG=commit-sha-here
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB_NAME=qbiq
REDIS_URL=redis://redis:6379
CACHE_TTL_SECONDS=300
CART_SESSION_TTL_SECONDS=86400
# Replace with http://YOUR_STATIC_IP after terraform apply
CORS_ORIGINS=["http://YOUR_STATIC_IP"]
