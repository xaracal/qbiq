# GitHub Pages build (repo: xaracal/qbiq → https://xaracal.github.io/qbiq/)
VITE_BASE_PATH=/qbiq/
# Point at a reachable HTTPS API (e.g. Docker backend via tunnel, or local dev backend)
VITE_API_BASE_URL=http://localhost:8000/api
# When true, probe API on startup and fall back to bundled demo data if unreachable
VITE_DEMO_FALLBACK=true
